{
  "name": "availability-sync-service",
  "version": "1.0.0",
  "description": "Syncs availability and price updates to Portal Sol",
  "scripts": {
    "test": "npm run test:unit && npm run test:fake",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-timeout=15000 'test/unit/*.test.ts'",
    "test:fake": "node --test --test-timeout=15000 --test-concurrency=1 'test/fake/*.test.ts'",
    "test:portal": "node --test --test-timeout=300000 --test-concurrency=1 'test/portal/*.test.ts'"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
